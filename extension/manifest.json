{
  "manifest_version": 3,
  "name": "FBKit - Facebook Automation",
  "version": "1.0.0",
  "description": "Facebook automation extension — works with FBKit Agent",
  "permissions": [
    "activeTab",
    "storage",
    "alarms",
    "scripting",
    "debugger",
    "cookies"
  ],
  "host_permissions": [
    "https://www.facebook.com/*",
    "https://facebook.com/*",
    "https://web.facebook.com/*",
    "https://mbasic.facebook.com/*",
    "https://m.facebook.com/*",
    "http://127.0.0.1:8100/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.facebook.com/*",
        "https://web.facebook.com/*",
        "https://facebook.com/*"
      ],
      "js": ["content-fb.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html"
  }
}
