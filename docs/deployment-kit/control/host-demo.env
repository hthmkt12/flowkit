# Host-demo profile for the same-VM lab on hth2-box.
# No secrets are stored here. The actual DB/Redis credentials stay encapsulated
# in the top-level start scripts on the VM.

CONTROL_API_URL=http://127.0.0.1:18080
CONTROL_API_PID_FILE=/home/hth2/flowkit-control-demo/control/control-api.pid
SCHEDULER_PID_FILE=/home/hth2/flowkit-control-demo/control/scheduler.pid
CONTROL_API_LOG=/home/hth2/flowkit-control-demo/control/control-api.log
SCHEDULER_LOG=/home/hth2/flowkit-control-demo/control/scheduler.log
CONTROL_API_START_SCRIPT=/home/hth2/flowkit-control-demo/start-control-api.sh
SCHEDULER_START_SCRIPT=/home/hth2/flowkit-control-demo/start-scheduler.sh
PYTHON_BIN=python3
